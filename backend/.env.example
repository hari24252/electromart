NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/electronics-commerce
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_PORT=8080
USER_JWT_SECRET=replace-with-a-long-user-secret-at-least-32-characters
ADMIN_JWT_SECRET=replace-with-a-long-admin-secret-at-least-32-characters
USER_REFRESH_JWT_SECRET=replace-with-a-long-user-refresh-secret-at-least-32-characters
ADMIN_REFRESH_JWT_SECRET=replace-with-a-long-admin-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_SECURE=false
CLOUDINARY_URL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
